# Local fictional demo only. The application reads process environment variables.
# This file is a reference, not loaded automatically by native Python launch.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
ENABLE_SEMANTIC=0
# Set on the Ollama server process, not just this application:
OLLAMA_NO_CLOUD=1
# Replace for any shared environment. Never deploy these sample values publicly.
DEMO_MCC_TOKEN=demo-mcc-local
DEMO_OCC_TOKEN=demo-occ-local
DEMO_VIEWER_TOKEN=demo-viewer-local
DEMO_SIMULATOR_TOKEN=demo-simulator-local

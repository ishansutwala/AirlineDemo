  "components": {
    "schemas": {
      "Advance": {
        "properties": {
          "clock_utc": {
            "type": "string",
            "title": "Clock Utc"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "clock_utc"
        ],
        "title": "Advance"
      },
      "Analyze": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "reference",
              "ollama"
            ],
            "title": "Mode",
            "default": "reference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Analyze"
      },
      "Approve": {
        "properties": {
          "case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Case Version"
          },
          "plan_hash": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Plan Hash"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_version",
          "plan_hash",
          "idempotency_key"
        ],
        "title": "Approve"
      },
      "Authorization": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED",
              "REVOKED"
            ],
            "title": "Status"
          },
          "issued_by": {
            "type": "string",
            "title": "Issued By"
          },
          "issued_at": {
            "type": "string",
            "title": "Issued At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "scope": {
            "type": "string",
            "const": "GROUND_PREPARATION_ONLY",
            "title": "Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "issued_by",
          "issued_at",
          "expires_at",
          "scope"
        ],
        "title": "Authorization"
      },
      "Event": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Event Id"
          },
          "source_system": {
            "type": "string",
            "const": "SIMULATED_MCC_ADAPTER",
            "title": "Source System"
          },
          "source_sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Sequence"
          },
          "operator_id": {
            "type": "string",
            "title": "Operator Id"
          },
          "aircraft_id": {
            "type": "string",
            "title": "Aircraft Id"
          },
          "flight_id": {
            "type": "string",
            "title": "Flight Id"
          },
          "next_flight_id": {
            "type": "string",
            "title": "Next Flight Id"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Destination"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "received_at": {
            "type": "string",
            "title": "Received At"
          },
          "fault_code": {
            "type": "string",
            "title": "Fault Code"
          },
          "reported_symptom": {
            "type": "string",
            "maxLength": 3000,
            "title": "Reported Symptom"
          },
          "crew_operational_status": {
            "type": "string",
            "maxLength": 200,
            "title": "Crew Operational Status"
          },
          "planning_authorization": {
            "$ref": "#/components/schemas/Authorization"
          },
          "safety_event_active": {
            "type": "boolean",
            "title": "Safety Event Active"
          },
          "data_class": {
            "type": "string",
            "const": "SYNTHETIC",
            "title": "Data Class"
          },
          "note": {
            "type": "string",
            "maxLength": 3000,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "event_id",
          "source_system",
          "source_sequence",
          "operator_id",
          "aircraft_id",
          "flight_id",
          "next_flight_id",
          "destination",
          "occurred_at",
          "received_at",
          "fault_code",
          "reported_symptom",
          "crew_operational_status",
          "planning_authorization",
          "safety_event_active",
          "data_class",
          "note"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Load": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "default": "nominal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Load"
      },
      "Outcome": {
        "properties": {
          "source_system": {
            "type": "string",
            "const": "SIMULATED_MAINTENANCE_SYSTEM",
            "title": "Source System"
          },
          "external_reference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 5,
            "title": "External Reference"
          },
          "status": {
            "type": "string",
            "enum": [
              "SERVICEABLE_RECORDED_EXTERNALLY",
              "MAINTENANCE_CONTINUES"
            ],
            "title": "Status"
          },
          "recorded_at": {
            "type": "string",
            "title": "Recorded At"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_system",
          "external_reference",
          "status",
          "recorded_at",
          "note"
        ],
        "title": "Outcome"
      },
      "Update": {
        "properties": {
          "source_sequence": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Source Sequence"
          },
          "destination": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "planning_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DISABLED",
                  "REVOKED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Planning Status"
          },
          "safety_event_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Event Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_sequence"
        ],
        "title": "Update"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
